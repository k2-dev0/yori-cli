{
  "name": "yori-cli",
  "version": "0.1.62",
  "type": "module",
  "description": "yori の管理CLI。会社・社員・案件・案件メンバー・認証トークンを管理する",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yori": "dist/yori.cjs"
  },
  "files": [
    "dist/yori.cjs",
    "dist/yori.cjs.map",
    "dist/collector/yori-collector.mjs",
    "dist/collector/collector-manifest.json",
    "dist/collector/yori-mcp.mjs",
    "dist/collector/mcp-manifest.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://yori:yori@127.0.0.1:55432/yori} node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:db": "node deployment/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "esbuild src/admin/bin.ts --bundle --platform=node --format=cjs --target=node24 --sourcemap --log-override:empty-import-meta=silent --outfile=dist/yori.cjs && node deployment/copy-collector.mjs && node deployment/copy-collector.mjs mcp",
    "prepack": "npm run build",
    "yori": "tsx src/admin/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "pg": "8.23.0",
    "smol-toml": "1.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "uuid": "13.0.2",
    "zod": "4.6.5"
  }
}
